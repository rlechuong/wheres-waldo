generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Scene {
  id           Int           @id @default(autoincrement())
  name         String
  slug         String        @unique
  publicId     String        @unique
  width        Int
  height       Int
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  characters   Character[]
  gameSessions GameSession[]
}

/// Check constraint added manually in migration:
/// Coordinates within [0,1], xMin < xMax, yMin < yMax
model Character {
  id                Int              @id @default(autoincrement())
  name              String
  thumbnailPublicId String
  xMin              Float
  xMax              Float
  yMin              Float
  yMax              Float
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  foundCharacters   FoundCharacter[]

  sceneId Int
  scene   Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([sceneId, name])
}

/// Check constraint added manually in migration:
/// player_name IS NULL OR finished_at IS NOT NULL
/// Partial index on (scene_id, finished_at) WHERE player_name IS NOT NULL
model GameSession {
  id              String           @id @default(uuid(7))
  playerName      String?
  startedAt       DateTime         @default(now()) @db.Timestamptz(3)
  finishedAt      DateTime?        @db.Timestamptz(3)
  foundCharacters FoundCharacter[]

  sceneId Int
  scene   Scene @relation(fields: [sceneId], references: [id], onDelete: Restrict)

  @@index([sceneId])
}

model FoundCharacter {
  gameSessionId String
  characterId   Int
  foundAt       DateTime @default(now()) @db.Timestamptz(3)

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  character   Character   @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([gameSessionId, characterId])
}
